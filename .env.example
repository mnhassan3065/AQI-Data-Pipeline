# Copy this file to .env and fill in the values.
# .env is gitignored - never commit real credentials.

# Breathe API
BREATHE_URL_ROOT=https://breathe-london-7x54d7qf.ew.gateway.dev/
BREATHE_API_KEY=replace-with-your-api-key

# LONAQN API
LONAQN_URL_ROOT=https://api.erg.ic.ac.uk/AirQuality

# Local MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=airquality
MYSQL_USER=project
MYSQL_PASSWORD=replace-with-a-strong-password

# Docker Compose only: root password for the MySQL container
MYSQL_ROOT_PASSWORD=localroot

# Web server (project-bottle.py)
FLASK_HOST=127.0.0.1
FLASK_DEBUG=false
